{
  "uid": "homelab-media-pipeline",
  "title": "Media Pipeline",
  "description": "Media automation troubleshooting. Is the pipeline flowing? Why can’t I reach Sonarr? Why is Plex buffering? Where is the bottleneck?",
  "tags": [
    "homelab",
    "media",
    "pipeline"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "30s",
  "schemaVersion": 39,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "links": [
    {
      "title": "← Overview",
      "type": "link",
      "url": "/d/homelab-overview",
      "tooltip": "Back to fleet triage",
      "icon": "arrow-left",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Container Workbench",
      "type": "link",
      "url": "/d/homelab-container-workbench",
      "tooltip": "Per-container CPU, memory, network detail",
      "icon": "external link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Network",
      "type": "link",
      "url": "/d/homelab-network",
      "tooltip": "Connectivity probes and bandwidth",
      "icon": "external link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Log Workbench",
      "type": "link",
      "url": "/d/homelab-log-workbench",
      "tooltip": "Log exploration and error triage",
      "icon": "external link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource_prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "label": "Prometheus",
        "refresh": 1
      },
      {
        "name": "datasource_loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "label": "Loki",
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource_prometheus}"
        },
        "query": "label_values(up, node)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "label": "Node"
      },
      {
        "name": "vm_role",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource_prometheus}"
        },
        "query": "label_values(up{node=~\"$node\"}, vm_role)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "label": "VM Role"
      },
      {
        "name": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource_prometheus}"
        },
        "query": "label_values(up{node=~\"$node\", vm_role=~\"$vm_role\"}, host)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "label": "Host"
      },
      {
        "name": "env",
        "type": "custom",
        "current": {
          "text": "prod",
          "value": "prod",
          "selected": true
        },
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "query": "prod",
        "options": [
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          }
        ]
      },
      {
        "name": "media_services",
        "type": "custom",
        "current": {
          "text": "sonarr|radarr|prowlarr|qbittorrent|vpn|flaresolverr|plex|jellyfin|bazarr|sabnzbd|recyclarr|buildarr",
          "value": "sonarr|radarr|prowlarr|qbittorrent|vpn|flaresolverr|plex|jellyfin|bazarr|sabnzbd|recyclarr|buildarr",
          "selected": true
        },
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "query": "sonarr|radarr|prowlarr|qbittorrent|vpn|flaresolverr|plex|jellyfin|bazarr|sabnzbd|recyclarr|buildarr",
        "options": [
          {
            "text": "sonarr|radarr|prowlarr|qbittorrent|vpn|flaresolverr|plex|jellyfin|bazarr|sabnzbd|recyclarr|buildarr",
            "value": "sonarr|radarr|prowlarr|qbittorrent|vpn|flaresolverr|plex|jellyfin|bazarr|sabnzbd|recyclarr|buildarr",
            "selected": true
          }
        ],
        "label": "Media Services Regex"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Media Services",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 300,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Services Running",
      "description": "Media containers detected by cAdvisor. Auto-populates when the media stack is deployed.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "count(container_last_seen{host=~\"$host\", service=~\"${media_services}\", name!=\"\", image!=\"\"} > (time() - 120)) or on() vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Health Issues",
      "description": "Media containers with failing Docker health checks.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "count(container_health_state{host=~\"$host\", service=~\"${media_services}\", name!=\"\", image!=\"\"} == 0 or container_health_state{host=~\"$host\", service=~\"${media_services}\", name!=\"\", image!=\"\"} >= 2) or on() vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "VPN Traffic",
      "description": "Current throughput on the VPN container (ExpressVPN). This IS the media stack’s internet egress — all torrent traffic routes through VPN. Zero when nothing is downloading.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "sum(rate(container_network_receive_bytes_total{host=~\"$host\", service=\"vpn\", name!=\"\", image!=\"\"}[$__rate_interval]) + rate(container_network_transmit_bytes_total{host=~\"$host\", service=\"vpn\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 0,
          "noValue": "VPN not deployed",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Recent Restarts",
      "description": "Media containers that restarted within the time range. Frequent restarts = crash loop.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "count(container_start_time_seconds{host=~\"$host\", service=~\"${media_services}\", name!=\"\", image!=\"\"} > (time() - $__range_s)) or on() vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Media Service Status",
      "description": "All media containers with resources and uptime. Click a service to investigate on the Container Workbench or view its logs. If a service is missing from this table, it’s not running.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "sum by (host, service) (rate(container_cpu_usage_seconds_total{host=~\"$host\", service=~\"${media_services}\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "sum by (host, service) (container_memory_working_set_bytes{host=~\"$host\", service=~\"${media_services}\", name!=\"\", image!=\"\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "time() - max by (host, service) (container_start_time_seconds{host=~\"$host\", service=~\"${media_services}\", name!=\"\", image!=\"\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "sum by (host, service) (rate(container_network_receive_bytes_total{host=~\"$host\", service=~\"${media_services}\", name!=\"\", image!=\"\"}[$__rate_interval]) + rate(container_network_transmit_bytes_total{host=~\"$host\", service=~\"${media_services}\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "host": 0,
              "service": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5
            },
            "renameByName": {
              "host": "Host",
              "service": "Service",
              "Value #A": "CPU %",
              "Value #B": "Memory",
              "Value #C": "Uptime",
              "Value #D": "Network"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Network"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Container detail →",
                    "url": "/d/homelab-container-workbench?${__url_time_range}&var-service=${__data.fields.Service}&var-host=${__data.fields.Host}",
                    "targetBlank": false
                  },
                  {
                    "title": "View Logs →",
                    "url": "/d/homelab-log-workbench?${__url_time_range}&var-service=${__data.fields.Service}&var-host=${__data.fields.Host}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "CPU %",
            "desc": true
          }
        ],
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "row",
      "title": "Errors & Pipeline Flow",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "id": 304,
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Queue Errors Over Time",
      "description": "Sonarr/Radarr queue errors and warnings. Non-zero errors = failed grabs (wrong quality, no seeds, indexer blocked). Click a spike to see what failed in the logs.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "sonarr_queue_error{host=~\"$host\"}",
          "legendFormat": "Sonarr errors",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "radarr_queue_error{host=~\"$host\"}",
          "legendFormat": "Radarr errors",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "sonarr_queue_warning{host=~\"$host\"}",
          "legendFormat": "Sonarr warnings",
          "range": true,
          "instant": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "radarr_queue_warning{host=~\"$host\"}",
          "legendFormat": "Radarr warnings",
          "range": true,
          "instant": false,
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "Deploy scraparr",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "links": [
            {
              "title": "See errors in Sonarr logs →",
              "url": "/d/homelab-log-workbench?${__url_time_range}&var-service=sonarr&var-level=error&var-level=warn",
              "targetBlank": true
            },
            {
              "title": "See errors in Radarr logs →",
              "url": "/d/homelab-log-workbench?${__url_time_range}&var-service=radarr&var-level=error&var-level=warn",
              "targetBlank": true
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/error/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/warning/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Indexer Health",
      "description": "Prowlarr indexer status. Green = healthy, red = unhealthy. Unhealthy indexers silently stop Sonarr/Radarr from finding content. Click to check Prowlarr logs.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "prowlarr_indexer_healthy{host=~\"$host\"}",
          "legendFormat": "{{indexer}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No indexers configured",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Check Prowlarr logs →",
