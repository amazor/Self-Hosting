{
  "uid": "homelab-host-workbench",
  "title": "Host Workbench",
  "description": "VM-level resource investigation. What's wrong with this VM's resources?",
  "tags": ["homelab", "host", "workbench"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "15s",
  "schemaVersion": 39,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "links": [
    {
      "title": "\u2190 Overview",
      "type": "link",
      "url": "/d/homelab-overview",
      "tooltip": "Back to fleet triage",
      "icon": "arrow-left",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Container Workbench",
      "type": "link",
      "url": "/d/homelab-container-workbench",
      "tooltip": "Container resource consumption, lifecycle, per-service detail",
      "icon": "external link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Log Workbench",
      "type": "link",
      "url": "/d/homelab-log-workbench",
      "tooltip": "Log exploration and error triage",
      "icon": "external link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource_prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "label": "Prometheus",
        "refresh": 1
      },
      {
        "name": "datasource_loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "label": "Loki",
        "description": "Passed to Log Workbench via drilldown links. Not used on this dashboard.",
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(up{job=\"node-exporter\"}, node)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "label": "Node"
      },
      {
        "name": "vm_role",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(up{job=\"node-exporter\", node=~\"$node\"}, vm_role)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "label": "VM Role"
      },
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(up{job=\"node-exporter\", node=~\"$node\", vm_role=~\"$vm_role\"}, host)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "label": "Host"
      },
      {
        "name": "env",
        "type": "custom",
        "current": { "text": "prod", "value": "prod", "selected": true },
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "query": "prod",
        "options": [
          { "text": "prod", "value": "prod", "selected": true }
        ]
      }
    ]
  },

  "panels": [

    {
      "type": "row",
      "title": "Quick Summary",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "id": 100,
      "panels": []
    },

    {
      "id": 1,
      "type": "stat",
      "title": "Load 1m",
      "description": "Worst-case 1-minute load average across selected hosts. Yellow at 2 (all cores busy on 2-vCPU VMs), red at 4 (overloaded).",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "max(node_load1{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})",
          "legendFormat": "Load 1m",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 4 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Load 5m",
      "description": "Worst-case 5-minute load average across selected hosts.",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "max(node_load5{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})",
          "legendFormat": "Load 5m",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 4 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Load 15m",
      "description": "Worst-case 15-minute load average across selected hosts.",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "max(node_load15{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})",
          "legendFormat": "Load 15m",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 4 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Swap Used",
      "description": "Worst-case swap usage across selected hosts. Any swap use means RAM was exhausted at some point.",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "max(node_memory_SwapTotal_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} - node_memory_SwapFree_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})",
          "legendFormat": "Swap",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 104857600 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "OOM Kills",
      "description": "Total OOM kill events across all selected hosts in the current time range. An OOM kill means the kernel terminated a process because memory was completely exhausted.",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum(increase(node_vmstat_oom_kill{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}[$__range])) OR on() vector(0)",
          "legendFormat": "OOM Kills",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" },
          "links": [
            {
              "title": "Investigate OOM in logs \u2192",
              "url": "/d/homelab-log-workbench?${__url_time_range}&${node:queryparam}&${vm_role:queryparam}&${host:queryparam}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      }
    },

    {
      "id": 6,
      "type": "stat",
      "title": "NTP Offset",
      "description": "Worst-case clock drift across selected hosts. High offset makes cross-VM log correlation unreliable.",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "max(abs(node_timex_offset_seconds{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}))",
          "legendFormat": "NTP Offset",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      }
    },

    {
      "type": "row",
      "title": "Host CPU",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 },
      "id": 101,
      "panels": []
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU by Mode",
      "description": "Average CPU time by mode across selected hosts. Shows where CPU time goes: user (app work), system (kernel), iowait (disk), steal (hypervisor contention). Note: when multiple hosts are selected, modes are averaged across all VMs — select a single host for accurate investigation.",
      "gridPos": { "x": 0, "y": 5, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "avg by (mode) (rate(node_cpu_seconds_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", mode!=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{mode}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" },
            "axisLabel": "",
            "axisSoftMin": 0
          },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "user" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "system" },
            "properties": [{ "id": "color", "value": { "fixedColor": "gold", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "iowait" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "steal" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "softirq" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "nice" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU % per Host",
      "description": "Total CPU busy percentage per host. One line per VM — identifies which VM to focus on before the mode breakdown explains why.",
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "1 - avg by (host) (rate(node_cpu_seconds_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "none" },
            "axisLabel": "",
            "axisSoftMin": 0,
            "axisSoftMax": 1
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "links": [
            {
              "title": "Which container? \u2192 Container Workbench",
              "url": "/d/homelab-container-workbench?${__url_time_range}&var-host=${__field.labels.host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },

    {
      "type": "row",
      "title": "Host Memory",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 },
      "id": 102,
      "panels": []
    },

    {
      "id": 22,
      "type": "timeseries",
      "title": "Memory Composition",
      "description": "Where RAM goes across selected hosts. Used = non-reclaimable (actual pressure). Cache = reclaimable by kernel on demand. Free = immediately available. Note: when multiple hosts are selected, values are averaged — select a single host for accurate investigation.",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "avg(node_memory_MemTotal_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} - node_memory_MemAvailable_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})",
          "legendFormat": "Used",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "avg(node_memory_MemAvailable_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} - node_memory_MemFree_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})",
          "legendFormat": "Cache / Buffers",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "avg(node_memory_MemFree_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})",
          "legendFormat": "Free",
          "range": true,
          "instant": false,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" },
            "axisSoftMin": 0
          },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Used" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Cache / Buffers" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Free" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Memory Used %",
      "description": "Percentage of memory in use per host. Based on MemAvailable (accounts for reclaimable cache/buffers). One line per VM for comparing hosts with different RAM sizes.",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "1 - (node_memory_MemAvailable_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} / node_memory_MemTotal_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "none" },
            "axisSoftMin": 0,
            "axisSoftMax": 1
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "links": [
            {
              "title": "Which container? \u2192 Container Workbench",
              "url": "/d/homelab-container-workbench?${__url_time_range}&var-host=${__field.labels.host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "Swap Usage",
      "description": "Swap bytes in use per host over time. Any swap use means RAM was exhausted at some point.",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "node_memory_SwapTotal_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} - node_memory_SwapFree_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "none" },
            "axisSoftMin": 0
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 104857600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },

    {
      "type": "row",
      "title": "Disk",
      "collapsed": true,
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 },
      "id": 103,
      "panels": [
        {
          "id": 30,
          "type": "bargauge",
          "title": "Filesystem Usage",
          "description": "Disk space used per mountpoint. Includes local and NFS mounts.",
          "gridPos": { "x": 0, "y": 31, "w": 12, "h": 8 },
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
              "editorMode": "code",
              "expr": "1 - (node_filesystem_avail_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", fstype=~\"ext4|xfs|btrfs|nfs|nfs4\", mountpoint!~\"/var/lib/docker/.*\"} / node_filesystem_size_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", fstype=~\"ext4|xfs|btrfs|nfs|nfs4\", mountpoint!~\"/var/lib/docker/.*\"})",
              "legendFormat": "{{host}}:{{mountpoint}}",
              "instant": true,
              "range": false,
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1,
              "thresholds": {
                "mode": "percentage",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 70 },
                  { "color": "red", "value": 85 }
                ]
              },
              "color": { "mode": "thresholds" },
              "links": [
                {
                  "title": "Investigate NFS / network \u2192",
                  "url": "/d/homelab-network?${__url_time_range}&${node:queryparam}&${vm_role:queryparam}&${host:queryparam}",
                  "targetBlank": false
                }
              ]
            },
            "overrides": []
          },
          "options": {
            "displayMode": "basic",
            "orientation": "horizontal",
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
            "showUnfilled": true,
            "minVizHeight": 10,
            "minVizWidth": 0
          }
        },
        {
          "id": 31,
          "type": "bargauge",
          "title": "Inode Usage",
          "description": "Inode usage per mountpoint. Independent failure mode from disk space \u2014 small files can exhaust inodes while disk % stays low.",
          "gridPos": { "x": 12, "y": 31, "w": 12, "h": 8 },
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
              "editorMode": "code",
              "expr": "1 - (node_filesystem_files_free{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", fstype=~\"ext4|xfs|btrfs|nfs|nfs4\", mountpoint!~\"/var/lib/docker/.*\"} / node_filesystem_files{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", fstype=~\"ext4|xfs|btrfs|nfs|nfs4\", mountpoint!~\"/var/lib/docker/.*\"})",
              "legendFormat": "{{host}}:{{mountpoint}}",
              "instant": true,
              "range": false,
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1,
              "thresholds": {
                "mode": "percentage",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 70 },
                  { "color": "red", "value": 85 }
                ]
              },
              "color": { "mode": "thresholds" }
            },
            "overrides": []
          },
          "options": {
            "displayMode": "basic",
            "orientation": "horizontal",
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
            "showUnfilled": true,
            "minVizHeight": 10,
            "minVizWidth": 0
          }
        },
        {
          "id": 32,
          "type": "timeseries",
          "title": "Disk I/O Rate",
          "description": "Read and write throughput per block device. Useful for finding which device is hot during high iowait.",
          "gridPos": { "x": 0, "y": 39, "w": 8, "h": 8 },
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
              "editorMode": "code",
              "expr": "rate(node_disk_read_bytes_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", device!~\"loop.*|dm-.*\"}[$__rate_interval])",
              "legendFormat": "{{host}}:{{device}} read",
              "range": true,
              "instant": false,
              "refId": "A"
            },
            {
              "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
              "editorMode": "code",
              "expr": "rate(node_disk_written_bytes_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", device!~\"loop.*|dm-.*\"}[$__rate_interval])",
              "legendFormat": "{{host}}:{{device}} write",
              "range": true,
              "instant": false,
              "refId": "B"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "Bps",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 10,
                "gradientMode": "none",
                "spanNulls": false,
                "showPoints": "never",
                "stacking": { "mode": "none" },
                "axisSoftMin": 0
              },
              "color": { "mode": "palette-classic" },
              "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
            },
            "overrides": []
          },
          "options": {
            "tooltip": { "mode": "multi", "sort": "desc" },
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
          }
        },
        {
          "id": 34,
          "type": "timeseries",
          "title": "Disk I/O Utilization",
          "description": "Fraction of time each block device was busy. Values near 1.0 mean the device is saturated. Complements I/O Rate (how much) and I/O Latency (how slow).",
          "gridPos": { "x": 8, "y": 39, "w": 8, "h": 8 },
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
              "editorMode": "code",
              "expr": "rate(node_disk_io_time_seconds_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", device!~\"loop.*|dm-.*\"}[$__rate_interval])",
              "legendFormat": "{{host}}:{{device}}",
              "range": true,
              "instant": false,
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1,
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 10,
                "gradientMode": "none",
                "spanNulls": false,
                "showPoints": "never",
                "stacking": { "mode": "none" },
                "axisSoftMin": 0,
                "axisSoftMax": 1
              },
              "color": { "mode": "palette-classic" },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 0.7 },
                  { "color": "red", "value": 0.9 }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "tooltip": { "mode": "multi", "sort": "desc" },
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
          }
        },
        {
          "id": 33,
          "type": "timeseries",
          "title": "Disk I/O Latency",
          "description": "Average time per I/O operation per device. High latency (especially on NFS) makes containers sluggish even when CPU and utilization look normal.",
          "gridPos": { "x": 16, "y": 39, "w": 8, "h": 8 },
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "targets": [
            {
              "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
              "editorMode": "code",
              "expr": "rate(node_disk_read_time_seconds_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", device!~\"loop.*|dm-.*\"}[$__rate_interval]) / clamp_min(rate(node_disk_reads_completed_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", device!~\"loop.*|dm-.*\"}[$__rate_interval]), 0.001)",
              "legendFormat": "{{host}}:{{device}} read",
              "range": true,
              "instant": false,
              "refId": "A"
            },
            {
              "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
              "editorMode": "code",
              "expr": "rate(node_disk_write_time_seconds_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", device!~\"loop.*|dm-.*\"}[$__rate_interval]) / clamp_min(rate(node_disk_writes_completed_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", device!~\"loop.*|dm-.*\"}[$__rate_interval]), 0.001)",
              "legendFormat": "{{host}}:{{device}} write",
              "range": true,
              "instant": false,
              "refId": "B"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 10,
                "gradientMode": "none",
                "spanNulls": false,
                "showPoints": "never",
                "stacking": { "mode": "none" },
                "axisSoftMin": 0
              },
              "color": { "mode": "palette-classic" },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 0.01 },
                  { "color": "red", "value": 0.05 }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "tooltip": { "mode": "multi", "sort": "desc" },
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
          }
        }
      ]
    },

    {
      "type": "row",
      "title": "Container Summary",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
      "id": 104,
      "panels": []
    },

    {
      "id": 40,
      "type": "table",
      "title": "Top Containers by CPU",
      "description": "Compact ranking of containers on selected hosts by CPU usage. Click a service name to investigate in the Container Workbench.",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (host, service) (rate(container_cpu_usage_seconds_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (host, service) (container_memory_working_set_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", name!=\"\", image!=\"\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "B"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {
              "host": 0,
              "service": 1,
              "Value #A": 2,
              "Value #B": 3
            },
            "renameByName": {
              "host": "Host",
              "service": "Service",
              "Value #A": "CPU %",
              "Value #B": "Memory"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 0.5 },
                    { "color": "red", "value": 0.9 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memory" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Service" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Investigate ${__data.fields.Service} \u2192 Container Workbench",
                    "url": "/d/homelab-container-workbench?${__url_time_range}&${node:queryparam}&${vm_role:queryparam}&var-host=${__data.fields.Host}&var-service=${__data.fields.Service}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "CPU %", "desc": true }],
        "cellHeight": "sm",
        "footer": { "show": false }
      }
    }

  ]
}
