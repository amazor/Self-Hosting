{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Log exploration and error triage. What went wrong? Search by service, severity, or free text (movie names, error messages).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "icon": "arrow-left",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "\u2190 Overview",
      "tooltip": "Back to fleet triage",
      "type": "link",
      "url": "/d/homelab-overview"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Host Workbench",
      "tooltip": "VM resources (CPU, memory, disk)",
      "type": "link",
      "url": "/d/homelab-host-workbench"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Container Workbench",
      "tooltip": "Container resources",
      "type": "link",
      "url": "/d/homelab-container-workbench"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Media Pipeline",
      "tooltip": "Media automation troubleshooting",
      "type": "link",
      "url": "/d/homelab-media-pipeline"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Network",
      "tooltip": "Connectivity and bandwidth",
      "type": "link",
      "url": "/d/homelab-network"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 400,
      "panels": [],
      "title": "Log Volume",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${datasource_loki}"
      },
      "description": "Log lines per second by severity across the selected scope. A spike in error/warn correlates with pipeline failures or incidents. Context panel \u2014 scan for anomalies before reading raw log lines.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "cps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "debug"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unknown"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "purple",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "editorMode": "code",
          "expr": "sum by (level) (rate({node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\"} |= `$search` [$__auto]))",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log Volume by Level",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 401,
      "panels": [],
      "title": "Error Rate per Service",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${datasource_loki}"
      },
      "description": "Error + fatal log lines per second, grouped by service. Excludes alloy (log shipper) and blackbox-exporter (probe churn) self-noise so real application errors aren't buried. Click a service line to focus the entire dashboard on that service. Pairs with D00 Top Offenders \u2014 D00 shows current count, this panel shows trend over time.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "links": [
            {
              "targetBlank": false,
              "title": "Focus on ${__field.labels.service}",
              "url": "/d/${__dashboard.uid}?${__url_time_range}&${node:queryparam}&${vm_role:queryparam}&${host:queryparam}&var-service=${__field.labels.service}&${level:queryparam}&var-search=${search:percentencode}"
            }
          ],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "cps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "editorMode": "code",
          "expr": "sum by (service) (rate({node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", level=~\"error|fatal\", service!~\"alloy|blackbox-exporter\"} [$__auto]))",
          "legendFormat": "{{service}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Error Rate per Service",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 404,
      "panels": [],
      "title": "Error Analysis",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${datasource_loki}"
      },
      "description": "Distinct error message shapes ranked by frequency over the visible time range. Messages are normalized (timestamps, hex ids, request ids, long tokens replaced with placeholders) so repeated errors with different embedded values group together. Turns the raw error rate into an actionable list instead of a scroll of individual lines. Click a row to narrow the Log Stream to that service at error level.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false,
            "inspect": false
          },
          "links": [
            {
              "targetBlank": false,
              "title": "Filter to ${__data.fields.Service}",
              "url": "/d/${__dashboard.uid}?${__url_time_range}&${node:queryparam}&${vm_role:queryparam}&${host:queryparam}&var-service=${__data.fields.Service}&var-level=error&var-search="
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "service"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Service"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "msg"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Message"
              },
              {
                "id": "custom.width",
                "value": 640
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "yellow",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 5
                    },
                    {
                      "color": "red",
                      "value": 20
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 13,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Count"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "editorMode": "code",
          "expr": "topk(20,\n  sum by (service, msg) (\n    count_over_time(\n      {node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", level=~\"error|fatal\", service!~\"alloy|blackbox-exporter\"} |= `$search`\n        | label_format msg=`{{ regexReplaceAll \"[0-9]+\" (regexReplaceAll \"[A-Za-z0-9+/_=.-]{20,}\" (regexReplaceAll \"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\" (regexReplaceAll \"\\\\[Req#[^\\\\]]*\\\\]\" __line__ \"\") \"<uuid>\") \"<token>\") \"N\" }}`\n      [$__range]\n    )\n  )\n)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top Error Patterns",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value #A": 2,
              "msg": 1,
              "service": 0
            },
            "renameByName": {
              "Value #A": "Count"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${datasource_loki}"
