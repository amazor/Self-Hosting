{
  "uid": "homelab-log-workbench",
  "title": "Log Workbench",
  "description": "Log exploration and error triage. What went wrong? Search by service, severity, or free text (movie names, error messages).",
  "tags": ["homelab", "log", "workbench"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "refresh": "",
  "schemaVersion": 39,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "links": [
    { "title": "\u2190 Overview", "type": "link", "url": "/d/homelab-overview",
      "tooltip": "Back to fleet triage", "icon": "arrow-left",
      "targetBlank": false, "includeVars": true, "keepTime": true },
    { "title": "Container Workbench", "type": "link", "url": "/d/homelab-container-workbench",
      "tooltip": "Container resources", "icon": "external link",
      "targetBlank": false, "includeVars": true, "keepTime": true },
    { "title": "Media Pipeline", "type": "link", "url": "/d/homelab-media-pipeline",
      "tooltip": "Media automation troubleshooting", "icon": "external link",
      "targetBlank": false, "includeVars": true, "keepTime": true },
    { "title": "Network", "type": "link", "url": "/d/homelab-network",
      "tooltip": "Connectivity and bandwidth", "icon": "external link",
      "targetBlank": false, "includeVars": true, "keepTime": true }
  ],
  "annotations": { "list": [
    { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" },
      "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)",
      "name": "Annotations & Alerts", "type": "dashboard" }
  ]},
  "templating": { "list": [
    { "name": "datasource_loki", "type": "datasource", "query": "loki",
      "current": {}, "hide": 0, "includeAll": false, "multi": false,
      "label": "Loki", "refresh": 1 },
    { "name": "datasource_prometheus", "type": "datasource", "query": "prometheus",
      "current": {}, "hide": 2, "includeAll": false, "multi": false,
      "label": "Prometheus", "refresh": 1 },
    { "name": "service", "type": "query",
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "query": "label_values({job=~\".+\"}, service)",
      "current": {}, "hide": 0, "includeAll": true, "multi": true,
      "allValue": ".+", "refresh": 2, "sort": 1, "label": "Service" },
    { "name": "level", "type": "custom",
      "current": { "text": "All", "value": "$__all" },
      "hide": 0, "includeAll": true, "multi": true,
      "allValue": ".+",
      "query": "error,warn,info,debug",
      "options": [
        { "text": "All", "value": "$__all", "selected": true },
        { "text": "error", "value": "error", "selected": false },
        { "text": "warn", "value": "warn", "selected": false },
        { "text": "info", "value": "info", "selected": false },
        { "text": "debug", "value": "debug", "selected": false }
      ],
      "label": "Level" },
    { "name": "search", "type": "textbox",
      "current": { "text": "", "value": "" },
      "hide": 0, "label": "Search",
      "description": "Free text search \u2014 movie titles, error messages, hostnames. Searches across all selected services." },
    { "name": "host", "type": "query",
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "query": "label_values({job=~\".+\"}, host)",
      "current": {}, "hide": 0, "includeAll": true, "multi": true,
      "allValue": ".+", "refresh": 2, "sort": 1, "label": "Host" },
    { "name": "node", "type": "query",
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "query": "label_values({job=~\".+\"}, node)",
      "current": {}, "hide": 0, "includeAll": true, "multi": true,
      "allValue": ".+", "refresh": 2, "sort": 1, "label": "Node" },
    { "name": "vm_role", "type": "query",
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "query": "label_values({job=~\".+\"}, vm_role)",
      "current": {}, "hide": 0, "includeAll": true, "multi": true,
      "allValue": ".+", "refresh": 2, "sort": 1, "label": "VM Role" },
    { "name": "env", "type": "custom",
      "current": { "text": "prod", "value": "prod", "selected": true },
      "hide": 2, "includeAll": false, "multi": false, "query": "prod",
      "options": [{ "text": "prod", "value": "prod", "selected": true }] }
  ]},

  "panels": [

    { "type": "row", "title": "Log Stream", "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "id": 400, "panels": [] },

    {
      "id": 1, "type": "logs", "title": "Logs",
      "description": "Live log stream filtered by service, level, and free text search. Use the $search variable to find specific movie/show names across all media services.",
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 18 },
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${datasource_loki}" },
        "editorMode": "code",
        "expr": "{service=~\"${service}\", host=~\"${host}\"} |= `$search`",
        "refId": "A"
      }],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },

    { "type": "row", "title": "Error Rate", "collapsed": false,
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 1 }, "id": 401, "panels": [] },

    {
      "id": 2, "type": "timeseries", "title": "Log Volume by Level",
      "description": "Log lines per second by severity. Error/warn spikes correlate with pipeline failures. Click a spike to narrow the time range in the logs panel above.",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 7 },
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "targets": [
        { "datasource": { "type": "loki", "uid": "${datasource_loki}" },
          "editorMode": "code",
          "expr": "sum by (level) (rate({service=~\"${service}\", host=~\"${host}\"} |= `$search` [$__auto]))",
          "legendFormat": "{{level}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0,
        "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80,
          "gradientMode": "none", "spanNulls": false, "showPoints": "never",
          "stacking": { "mode": "normal" } },
        "color": { "mode": "palette-classic" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
      }, "overrides": [
        { "matcher": { "id": "byName", "options": "error" }, "properties": [
          { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" }}]},
        { "matcher": { "id": "byName", "options": "warn" }, "properties": [
          { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" }}]},
        { "matcher": { "id": "byName", "options": "info" }, "properties": [
          { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" }}]},
        { "matcher": { "id": "byName", "options": "debug" }, "properties": [
          { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" }}]},
        { "matcher": { "id": "byName", "options": "unknown" }, "properties": [
          { "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" }}]}
      ]},
      "options": { "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }}
    }

  ]
}
