    {
      "id": 11,
      "type": "stat",
      "title": "Log Freshness",
      "description": "Log volume per VM (lines/min). The sparkline is the signal: a steady line means healthy pipeline, a cliff to zero means Alloy stopped shipping, a sudden spike means log churn from an incident. STALE means zero logs in the current window.",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource_loki}" },
          "editorMode": "code",
          "expr": "sum by (host, node, vm_role) (rate({node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}[5m])) * 60",
          "queryType": "range",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
