            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "mappings": [],
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "noValue": "N/A",
          "links": [
            {
              "title": "\u2192 Infra Workbench",
              "url": "/d/homelab-infra-workbench?from=${__from}&to=${__to}&var-vm_role=${__field.labels.vm_role}&var-host=${__field.labels.host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75
      }
    },

    {
      "id": 12,
      "type": "stat",
      "title": "Scrape Staleness",
      "description": "Seconds since the last successful Prometheus scrape per VM. High values indicate collection problems.",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "time() - max by (host) (timestamp(up{job=\"node-exporter\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}))",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          },
          "mappings": [],
          "unit": "s",
          "decimals": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Container Restarts",
      "description": "Container restart count per VM in the current time range. Restarts are detected via changes in container start time.",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (host, vm_role) (changes(container_start_time_seconds{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", name!=\"\", image!=\"\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
