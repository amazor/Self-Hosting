    {
      "id": 6,
      "type": "table",
      "title": "Top Offenders",
      "description": "Services producing the most errors in the selected time range, ranked by error count with restart context. Restarts are detected via the recency method (container_start_time_seconds within the time window) — consistent with the fleet Restarts panel and immune to cAdvisor series drops during stop+start cycles. Empty when healthy — that's by design.",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 6 },
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource_loki}" },
          "editorMode": "code",
          "expr": "sum by (node, host, service) (count_over_time({node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", level=~\"error|fatal\"}[$__range]))",
          "queryType": "instant",
          "legendFormat": "Errors",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "count by (node, host, service) (container_start_time_seconds{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service!=\"\", name!=\"\", image!=\"\"} > (time() - $__range_s))",
          "instant": true,
          "range": false,
