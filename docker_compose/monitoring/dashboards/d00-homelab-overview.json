{
  "uid": "homelab-overview",
  "title": "Homelab Overview",
  "description": "Fleet-level triage board. Is something wrong? Where do I click?",
  "tags": ["homelab", "overview", "noc"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "30s",
  "schemaVersion": 39,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "links": [
    {
      "title": "Infra Workbench",
      "type": "link",
      "url": "/d/homelab-infra-workbench",
      "tooltip": "Host + container metrics deep dive",
      "icon": "external link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Log Workbench",
      "type": "link",
      "url": "/d/homelab-log-workbench",
      "tooltip": "Log exploration and error triage",
      "icon": "external link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource_prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "label": "Prometheus",
        "refresh": 1
      },
      {
        "name": "datasource_loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "label": "Loki",
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(up{job=\"node-exporter\"}, node)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "label": "Node"
      },
      {
        "name": "vm_role",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(up{job=\"node-exporter\", node=~\"$node\"}, vm_role)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "label": "VM Role"
      },
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(up{job=\"node-exporter\", node=~\"$node\", vm_role=~\"$vm_role\"}, host)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "label": "Host"
      },
      {
        "name": "env",
        "type": "custom",
        "current": { "text": "prod", "value": "prod", "selected": true },
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "query": "prod",
        "options": [
          { "text": "prod", "value": "prod", "selected": true }
        ]
      }
    ]
  },
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Host Status",
      "description": "Number of VMs with a failed node_exporter scrape. Zero means all hosts are reachable. Click to investigate in the Infra Workbench.",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "count(up{job=\"node-exporter\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} == 0) OR on() vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "All Hosts UP", "index": 0 }
              }
            }
          ],
          "noValue": "N/A",
          "links": [
            {
              "title": "\u2192 Infra Workbench",
              "url": "/d/homelab-infra-workbench?from=${__from}&to=${__to}&var-node=${var-node}&var-vm_role=${var-vm_role}&var-host=${var-host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Errors /min",
      "description": "Fleet-wide error + fatal log rate per minute. Sparkline shows trend direction — rising means the situation is getting worse.",
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 3 },
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource_loki}" },
          "editorMode": "code",
          "expr": "sum(rate({node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", level=~\"error|fatal\"}[5m])) * 60",
          "queryType": "range",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 5 }
            ]
          },
          "mappings": [],
          "decimals": 1,
          "noValue": "0",
          "links": [
            {
              "title": "\u2192 Log Workbench",
              "url": "/d/homelab-log-workbench?from=${__from}&to=${__to}&var-node=${var-node}&var-vm_role=${var-vm_role}&var-host=${var-host}&var-level=error",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Restarts",
      "description": "Fleet-wide container restarts detected. Sparkline shows restart distribution over the time range — a spike indicates a crash loop.",
      "gridPos": { "x": 10, "y": 0, "w": 5, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum(changes(container_start_time_seconds{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", name!=\"\", image!=\"\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "mappings": [],
          "noValue": "0",
          "links": [
            {
              "title": "\u2192 Infra Workbench",
              "url": "/d/homelab-infra-workbench?from=${__from}&to=${__to}&var-node=${var-node}&var-vm_role=${var-vm_role}&var-host=${var-host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },

    {
      "id": 12,
      "type": "stat",
      "title": "Stopped Containers",
      "description": "Fleet-wide count of containers in a stopped/exited state that are not restarting. A stopped container won't increment the Restarts counter — this is the only panel that catches it. Zero is the only healthy value.",
      "gridPos": { "x": 15, "y": 0, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum(container_tasks_state{state=\"stopped\", name!=\"\", image!=\"\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}) OR on() vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "All Running", "index": 0 }
              }
            }
          ],
          "noValue": "N/A",
          "links": [
            {
              "title": "\u2192 Infra Workbench",
              "url": "/d/homelab-infra-workbench?from=${__from}&to=${__to}&var-node=${var-node}&var-vm_role=${var-vm_role}&var-host=${var-host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Scrape Health",
      "description": "Percentage of Prometheus scrape targets currently UP. Below 100% means at least one target is unreachable. Click to investigate in the Infra Workbench.",
      "gridPos": { "x": 19, "y": 0, "w": 5, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "avg(up{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}) * 100",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          },
          "mappings": [],
          "unit": "percent",
          "decimals": 0,
          "noValue": "N/A",
          "links": [
            {
              "title": "\u2192 Infra Workbench",
              "url": "/d/homelab-infra-workbench?from=${__from}&to=${__to}&var-node=${var-node}&var-vm_role=${var-vm_role}&var-host=${var-host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "VM Availability",
      "description": "Per-VM node_exporter status. Click a VM to drill down to the Infra Workbench.",
      "gridPos": { "x": 0, "y": 3, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "max by (host, vm_role) (up{job=\"node-exporter\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "dark-red", "value": null },
              { "color": "dark-green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "index": 0 },
                "1": { "text": "UP", "index": 1 }
              }
            }
          ],
          "noValue": "N/A",
          "links": [
            {
              "title": "\u2192 Infra Workbench",
              "url": "/d/homelab-infra-workbench?from=${__from}&to=${__to}&var-vm_role=${__field.labels.vm_role}&var-host=${__field.labels.host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },

    {
      "id": 6,
      "type": "table",
      "title": "Top Offenders",
      "description": "Services producing the most errors in the selected time range, ranked by error count with restart context. A service with errors AND restarts is more urgent than one with only errors.",
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 6 },
      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource_loki}" },
          "editorMode": "code",
          "expr": "sum by (node, host, service) (count_over_time({node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", level=~\"error|fatal\"}[$__range]))",
          "queryType": "instant",
          "legendFormat": "",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (node, host, service) (changes(container_start_time_seconds{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service!=\"\", name!=\"\", image!=\"\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "service",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "node 2": true,
              "host 2": true
            },
            "renameByName": {
              "node 1": "node",
              "host 1": "host"
            },
            "indexByName": {
              "node 1": 0,
              "host 1": 1,
              "service": 2,
              "Value #A": 3,
              "Value #B": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null }
            ]
          },
          "links": [
            {
              "title": "\u2192 Log Workbench",
              "url": "/d/homelab-log-workbench?from=${__from}&to=${__to}&var-node=${__data.fields.node}&var-host=${__data.fields.host}&var-service=${__data.fields.service}&var-level=error",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "node" },
            "properties": [
              { "id": "displayName", "value": "Node" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "host" },
            "properties": [
              { "id": "displayName", "value": "Host" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "service" },
            "properties": [
              { "id": "displayName", "value": "Service" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #A" },
            "properties": [
              { "id": "displayName", "value": "Errors" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "yellow", "value": null },
                    { "color": "orange", "value": 10 },
                    { "color": "red", "value": 50 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #B" },
            "properties": [
              { "id": "displayName", "value": "Restarts" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "text", "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "orange", "value": 3 },
                    { "color": "red", "value": 5 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Errors", "desc": true }],
        "cellHeight": "sm",
        "footer": { "show": false }
      }
    },

    {
      "id": 7,
      "type": "bargauge",
      "title": "CPU",
      "description": "Current CPU utilization per VM. Based on the idle rate over the last 5 minutes.",
      "gridPos": { "x": 0, "y": 13, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "(1 - avg by (host, vm_role) (rate(node_cpu_seconds_total{mode=\"idle\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}[5m]))) * 100",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "mappings": [],
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "noValue": "N/A",
          "links": [
            {
              "title": "\u2192 Infra Workbench",
              "url": "/d/homelab-infra-workbench?from=${__from}&to=${__to}&var-vm_role=${__field.labels.vm_role}&var-host=${__field.labels.host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 25
      }
    },

    {
      "id": 8,
      "type": "bargauge",
      "title": "Memory",
      "description": "Current memory utilization per VM. Based on MemAvailable vs MemTotal.",
      "gridPos": { "x": 8, "y": 13, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "(1 - (node_memory_MemAvailable_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} / node_memory_MemTotal_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})) * 100",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "mappings": [],
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "noValue": "N/A",
          "links": [
            {
              "title": "\u2192 Infra Workbench",
              "url": "/d/homelab-infra-workbench?from=${__from}&to=${__to}&var-vm_role=${__field.labels.vm_role}&var-host=${__field.labels.host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 25
      }
    },

    {
      "id": 9,
      "type": "bargauge",
      "title": "Disk",
      "description": "Root filesystem utilization per VM.",
      "gridPos": { "x": 16, "y": 13, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"tmpfs\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!=\"tmpfs\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})) * 100",
          "instant": true,
          "range": false,
