{
  "uid": "homelab-overview",
  "title": "Homelab Overview",
  "description": "Fleet-level triage board. Answers: Is my homelab healthy right now?",
  "tags": ["homelab", "overview", "noc"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "30s",
  "schemaVersion": 39,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource_prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "label": "Prometheus",
        "refresh": 1
      },
      {
        "name": "datasource_loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "label": "Loki",
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(up{job=\"node-exporter\"}, node)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "label": "Node"
      },
      {
        "name": "vm_role",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(up{job=\"node-exporter\", node=~\"$node\"}, vm_role)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "label": "VM Role"
      },
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(up{job=\"node-exporter\", node=~\"$node\", vm_role=~\"$vm_role\"}, host)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "label": "Host"
      },
      {
        "name": "env",
        "type": "custom",
        "current": { "text": "prod", "value": "prod", "selected": true },
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "query": "prod",
        "options": [
          { "text": "prod", "value": "prod", "selected": true }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hosts Up",
      "description": "Number of VMs with a healthy node_exporter scrape.",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "count(up{job=\"node-exporter\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} == 1) OR on() vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hosts Down",
      "description": "VMs where node_exporter is unreachable. Any value above 0 needs immediate investigation.",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "count(up{job=\"node-exporter\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} == 0) OR on() vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors",
      "description": "Total error + fatal log lines across the fleet in the current time range.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 3 },
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource_loki}" },
          "editorMode": "code",
          "expr": "sum(count_over_time({node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", level=~\"error|fatal\"} [$__range]))",
          "queryType": "instant",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Warnings",
      "description": "Total warning log lines across the fleet in the current time range.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 3 },
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource_loki}" },
          "editorMode": "code",
          "expr": "sum(count_over_time({node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", level=\"warn\"} [$__range]))",
          "queryType": "instant",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "orange", "value": 100 }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Restarts",
      "description": "Container restarts detected across the fleet. Frequent restarts indicate instability.",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum(changes(container_start_time_seconds{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", name!=\"\", image!=\"\"}[$__range])) OR on() vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Scrape Health",
      "description": "Percentage of Prometheus scrape targets currently UP.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "avg(up{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}) * 100",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          },
          "mappings": [],
          "unit": "percent",
          "decimals": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },

    {
      "id": 7,
      "type": "stat",
      "title": "VM Availability",
      "description": "Per-VM node_exporter status. Click a VM to drill down to the Infra Workbench.",
      "gridPos": { "x": 0, "y": 3, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "up{job=\"node-exporter\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "dark-red", "value": null },
              { "color": "dark-green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "index": 0 },
                "1": { "text": "UP", "index": 1 }
              }
            }
          ],
          "noValue": "N/A",
          "links": [
            {
              "title": "\u2192 Infra Workbench",
              "url": "/d/homelab-infra-workbench?from=${__from}&to=${__to}&var-vm_role=${__field.labels.vm_role}&var-host=${__field.labels.host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },

    {
      "id": 8,
      "type": "stat",
      "title": "Error Rates by VM",
      "description": "Error + fatal log count per VM in the current time range. Click to drill down to the Log Workbench. VMs with zero errors are hidden.",
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 4 },
      "datasource": { "type": "loki", "uid": "${datasource_loki}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${datasource_loki}" },
          "editorMode": "code",
          "expr": "sum by (host, vm_role) (count_over_time({node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", level=~\"error|fatal\"} [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "mappings": [],
          "noValue": "No errors \u2714",
          "links": [
            {
              "title": "\u2192 Log Workbench",
              "url": "/d/homelab-log-workbench?from=${__from}&to=${__to}&var-vm_role=${__field.labels.vm_role}&var-host=${__field.labels.host}&var-level=error",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "orientation": "auto"
      }
    },

    {
      "id": 9,
      "type": "gauge",
      "title": "CPU",
      "description": "Current CPU utilization per VM. Based on the idle rate over the last 5 minutes.",
      "gridPos": { "x": 0, "y": 11, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "(1 - avg by (host, vm_role) (rate(node_cpu_seconds_total{mode=\"idle\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}[5m]))) * 100",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "mappings": [],
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "noValue": "N/A",
          "links": [
            {
              "title": "\u2192 Infra Workbench",
              "url": "/d/homelab-infra-workbench?from=${__from}&to=${__to}&var-vm_role=${__field.labels.vm_role}&var-host=${__field.labels.host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75
      }
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "Memory",
      "description": "Current memory utilization per VM. Based on MemAvailable vs MemTotal.",
      "gridPos": { "x": 8, "y": 11, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "(1 - (node_memory_MemAvailable_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} / node_memory_MemTotal_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})) * 100",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "mappings": [],
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "noValue": "N/A",
          "links": [
            {
              "title": "\u2192 Infra Workbench",
              "url": "/d/homelab-infra-workbench?from=${__from}&to=${__to}&var-vm_role=${__field.labels.vm_role}&var-host=${__field.labels.host}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75
      }
    },
    {
      "id": 11,
      "type": "gauge",
      "title": "Disk",
      "description": "Root filesystem utilization per VM.",
      "gridPos": { "x": 16, "y": 11, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"tmpfs\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!=\"tmpfs\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})) * 100",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
