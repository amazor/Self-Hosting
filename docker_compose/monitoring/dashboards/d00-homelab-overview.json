{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Fleet-level triage board. Is something wrong? Where do I click?",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Host Workbench",
      "tooltip": "VM-level metrics: CPU, memory, disk, I/O",
      "type": "link",
      "url": "/d/homelab-host-workbench"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Container Workbench",
      "tooltip": "Container resource consumption, lifecycle, per-service detail",
      "type": "link",
      "url": "/d/homelab-container-workbench"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Log Workbench",
      "tooltip": "Log exploration and error triage",
      "type": "link",
      "url": "/d/homelab-log-workbench"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Network & Connectivity",
      "tooltip": "Probes, DNS, throughput, TLS",
      "type": "link",
      "url": "/d/homelab-network"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "title": "Media Pipeline",
      "tooltip": "Download queue, indexers, Plex/Jellyfin sessions",
      "type": "link",
      "url": "/d/homelab-media-pipeline"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "description": "Number of VMs with a failed node_exporter scrape. Zero means all hosts are reachable. Click to investigate in the Host Workbench.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "targetBlank": false,
              "title": "\u2192 Host Workbench",
              "url": "/d/homelab-host-workbench?${__url_time_range}&${node:queryparam}&${vm_role:queryparam}&${host:queryparam}"
            }
          ],
          "mappings": [
            {
              "options": {
                "0": {
                  "index": 0,
                  "text": "All Hosts UP"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "count(up{job=\"node-exporter\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} == 0) OR on() vector(0)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Host Status",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${datasource_loki}"
      },
      "description": "Fleet-wide error + fatal log rate per minute. Sparkline shows trend direction \u2014 rising means the situation is getting worse.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "links": [
            {
              "targetBlank": false,
              "title": "\u2192 Log Workbench",
              "url": "/d/homelab-log-workbench?${__url_time_range}&${node:queryparam}&${vm_role:queryparam}&${host:queryparam}&var-level=error&var-search="
            }
          ],
          "mappings": [],
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource_loki}"
          },
          "editorMode": "code",
          "expr": "sum(rate({node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service!~\"alloy|blackbox-exporter\", level=~\"error|fatal\"}[5m])) * 60",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Errors /min",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "description": "Number of containers currently below the expected fleet count (deficit). Expected = peak running count over the last 1 hour. Zero means all containers are up. A non-zero value means one or more containers went down. The sparkline shows the deficit over time \u2014 restart events appear as brief spikes that return to zero once the container recovers. 1h window (was 24h) so an intentional container removal self-heals within an hour instead of lingering as a false deficit for a full day.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "links": [
            {
              "targetBlank": false,
              "title": "\u2192 Container Workbench",
              "url": "/d/homelab-container-workbench?${__url_time_range}&${node:queryparam}&${vm_role:queryparam}&${host:queryparam}"
            }
          ],
          "mappings": [
            {
              "options": {
                "0": {
                  "index": 0,
                  "text": "All Up"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 12,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "clamp_min(clamp_min(max_over_time(count(container_start_time_seconds{name!=\"\", image!=\"\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})[1h:5m]), 1) - count(container_start_time_seconds{name!=\"\", image!=\"\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}), 0) OR on() vector(0)",
          "instant": false,
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Containers",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "description": "Per-VM node_exporter status. Click a VM to drill down to the Host Workbench.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "targetBlank": false,
              "title": "\u2192 Host Workbench",
              "url": "/d/homelab-host-workbench?${__url_time_range}&var-vm_role=${__field.labels.vm_role}&var-host=${__field.labels.host}"
            }
          ],
          "mappings": [
            {
              "options": {
                "0": {
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "index": 1,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "dark-green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "max by (host, vm_role) (up{job=\"node-exporter\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})",
          "instant": true,
          "legendFormat": "{{host}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "VM Availability",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "description": "Current CPU utilization per VM. Based on the idle rate over the last 2 minutes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "links": [
            {
              "targetBlank": false,
              "title": "\u2192 Host Workbench",
              "url": "/d/homelab-host-workbench?${__url_time_range}&var-vm_role=${__field.labels.vm_role}&var-host=${__field.labels.host}"
            }
          ],
          "mappings": [],
          "max": 100,
          "min": 0,
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 7
      },
      "id": 7,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 25,
        "minVizWidth": 8,
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "(1 - avg by (host, vm_role) (rate(node_cpu_seconds_total{mode=\"idle\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}[2m]))) * 100",
          "instant": true,
          "legendFormat": "{{host}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "CPU",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "description": "Current memory utilization per VM. Based on MemAvailable vs MemTotal. Aggregated with max to prevent duplicate series from multiple scrape paths.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "links": [
            {
              "targetBlank": false,
              "title": "\u2192 Host Workbench",
              "url": "/d/homelab-host-workbench?${__url_time_range}&var-vm_role=${__field.labels.vm_role}&var-host=${__field.labels.host}"
            }
          ],
          "mappings": [],
          "max": 100,
          "min": 0,
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 7
      },
      "id": 8,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 25,
        "minVizWidth": 8,
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "(1 - (max by (host, vm_role) (node_memory_MemAvailable_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}) / max by (host, vm_role) (node_memory_MemTotal_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"}))) * 100",
          "instant": true,
          "legendFormat": "{{host}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Memory",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "description": "Filesystem utilization per VM (root disk) and NFS mounts (shared NAS storage). NFS query excludes nested sub-path mounts (e.g. a VM mounting a subdirectory of another VM's NAS export) so the same underlying NAS volume isn't double-counted as separate bars. NFS filling up silently stops downloads and recordings while containers appear healthy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "links": [
            {
              "targetBlank": false,
              "title": "\u2192 Host Workbench",
              "url": "/d/homelab-host-workbench?${__url_time_range}&var-vm_role=${__field.labels.vm_role}&var-host=${__field.labels.host}"
            }
          ],
          "mappings": [],
          "max": 100,
          "min": 0,
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 7
      },
      "id": 9,
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 24,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "manual",
        "text": {
          "titleSize": 12,
          "valueSize": 12
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "max by (host, vm_role) ((1 - (node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"tmpfs\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!=\"tmpfs\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})) * 100)",
          "instant": true,
          "legendFormat": "{{host}}",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "max by (host, vm_role, mountpoint) ((1 - (node_filesystem_avail_bytes{fstype=~\"nfs|nfs4\", mountpoint!~\"^/mnt/[^/]+/.+\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"} / node_filesystem_size_bytes{fstype=~\"nfs|nfs4\", mountpoint!~\"^/mnt/[^/]+/.+\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})) * 100)",
          "instant": true,
          "legendFormat": "NFS {{host}}:{{mountpoint}}",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Disk",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "description": "Running vs expected containers per VM. Expected = peak running count over the last 1 hour (shortened from 24h so an intentional container removal doesn't look like an incident for a full day). The gauge column fills green when all containers are up; a deficit is immediately visible. Click a row to drill into the Container Workbench.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "targetBlank": false,
              "title": "\u2192 Container Workbench",
              "url": "/d/homelab-container-workbench?${__url_time_range}&var-node=${__data.fields.node}&var-vm_role=${__data.fields.vm_role}&var-host=${__data.fields.Host}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vm_role"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "node"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Host"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 35
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Exp"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 40
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "applyToRow": true,
                  "type": "color-background"
                }
              },
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.8
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.width",
                "value": 55
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "id": 13,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "fields": [
            "Up",
            "Exp"
          ],
          "reducer": [
            "sum"
          ],
          "show": true
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Host"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "count by (host, vm_role, node) (container_start_time_seconds{name!=\"\", image!=\"\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "clamp_min(max_over_time(count by (host, vm_role, node) (container_start_time_seconds{name!=\"\", image!=\"\", node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\"})[1h:5m]), 1)",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "title": "Containers Running",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Health",
            "binary": {
              "left": "Value #A",
              "operator": "/",
              "right": "Value #B"
            },
            "mode": "binary",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
