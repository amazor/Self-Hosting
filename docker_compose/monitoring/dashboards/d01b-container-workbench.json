{
  "uid": "homelab-container-workbench",
  "title": "Container Workbench",
  "description": "Container resource investigation. Which container is responsible and what's it doing?",
  "tags": ["homelab", "container", "workbench"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "30s",
  "schemaVersion": 39,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "links": [
    {
      "title": "\u2190 Overview",
      "type": "link",
      "url": "/d/homelab-overview",
      "tooltip": "Back to fleet triage",
      "icon": "arrow-left",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Host Workbench",
      "type": "link",
      "url": "/d/homelab-host-workbench",
      "tooltip": "VM-level metrics: CPU, memory, disk, I/O",
      "icon": "external link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Log Workbench",
      "type": "link",
      "url": "/d/homelab-log-workbench",
      "tooltip": "Log exploration and error triage",
      "icon": "external link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource_prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "label": "Prometheus",
        "refresh": 1
      },
      {
        "name": "datasource_loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "label": "Loki",
        "description": "Passed to Log Workbench via drilldown links. Not used on this dashboard.",
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(up, node)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "label": "Node"
      },
      {
        "name": "vm_role",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(up{node=~\"$node\"}, vm_role)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "label": "VM Role"
      },
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(up{node=~\"$node\", vm_role=~\"$vm_role\"}, host)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "label": "Host"
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
        "query": "label_values(container_cpu_usage_seconds_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", name!=\"\", image!=\"\"}, service)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 2,
        "sort": 1,
        "label": "Service"
      },
      {
        "name": "env",
        "type": "custom",
        "current": { "text": "prod", "value": "prod", "selected": true },
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "query": "prod",
        "options": [
          { "text": "prod", "value": "prod", "selected": true }
        ]
      }
    ]
  },

  "panels": [

    {
      "type": "row",
      "title": "At a Glance",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "id": 100,
      "panels": []
    },

    {
      "id": 1,
      "type": "stat",
      "title": "Containers Running",
      "description": "Number of containers seen by cAdvisor within the last 120 seconds across the selected scope.",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "count(container_last_seen{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"} > (time() - 120))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "CPU Heavy",
      "description": "Count of containers using more than 50% of a CPU core. Zero is healthy.",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "count(sum by (host,service)(rate(container_cpu_usage_seconds_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}[$__rate_interval])) > 0.5) or on() vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Memory Pressure",
      "description": "Containers above 70% of Docker memory limit. Only counts containers with explicit limits set.",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "count(sum by (host,service)(container_memory_working_set_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}) / sum by (host,service)(container_spec_memory_limit_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"} > 0) > 0.7) or on() vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Health Issues",
      "description": "Containers with failing Docker health checks (starting or unhealthy). Excludes containers without health checks.",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "count(container_health_state{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"} == 0 or container_health_state{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"} >= 2) or on() vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },

    {
      "id": 6,
      "type": "stat",
      "title": "OOM Events",
      "description": "Total OOM kills across all containers. Should always be 0.",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum(container_oom_events_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}) or on() vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Recent Restarts",
      "description": "Containers that started within the current dashboard time range \u2014 indicates a restart or fresh deployment.",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "count(container_start_time_seconds{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"} > (time() - $__range_s)) or on() vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },

    {
      "type": "row",
      "title": "Container Resources",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 },
      "id": 101,
      "panels": []
    },

    {
      "id": 40,
      "type": "table",
      "title": "Container Resource Table",
      "description": "All containers on selected hosts ranked by CPU. Click a service name to focus this dashboard on that container, or use View Logs to jump to the Log Workbench.",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (host,service)(rate(container_cpu_usage_seconds_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (host,service)(container_memory_working_set_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (host,service)(container_memory_working_set_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}) / sum by (host,service)(container_spec_memory_limit_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"} > 0)",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (host,service)(rate(container_network_receive_bytes_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (host,service)(rate(container_network_transmit_bytes_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "E"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "time() - max by (host,service)(container_start_time_seconds{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "F"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (host,service)(rate(container_fs_writes_bytes_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "G"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {
              "host": 0,
              "service": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #F": 5,
              "Value #G": 6,
              "Value #D": 7,
              "Value #E": 8
            },
            "renameByName": {
              "host": "Host",
              "service": "Service",
              "Value #A": "CPU %",
              "Value #B": "Memory",
              "Value #C": "Mem Limit %",
              "Value #F": "Uptime",
              "Value #G": "Disk Writes",
              "Value #D": "Net In",
              "Value #E": "Net Out"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Host" },
            "properties": [
              { "id": "custom.width", "value": 120 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 0.5 },
                    { "color": "red", "value": 0.9 }
                  ]
                }
              },
              { "id": "color", "value": { "mode": "continuous-GrYlRd" } },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memory" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Mem Limit %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 0 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 0.7 },
                    { "color": "red", "value": 0.9 }
                  ]
                }
              },
              { "id": "color", "value": { "mode": "continuous-GrYlRd" } },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null+nan",
                      "result": { "text": "\u2014", "index": 0 }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Uptime" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Disk Writes" },
            "properties": [
              { "id": "unit", "value": "Bps" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Net In" },
            "properties": [
              { "id": "unit", "value": "Bps" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Net Out" },
            "properties": [
              { "id": "unit", "value": "Bps" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Service" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Focus on ${__data.fields.Service}",
                    "url": "/d/homelab-container-workbench?${__url_time_range}&var-service=${__data.fields.Service}&var-host=${__data.fields.Host}&${node:queryparam}&${vm_role:queryparam}",
                    "targetBlank": false
                  },
                  {
                    "title": "View Logs \u2192",
                    "url": "/d/homelab-log-workbench?${__url_time_range}&var-host=${__data.fields.Host}&var-service=${__data.fields.Service}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "CPU %", "desc": true }],
        "cellHeight": "sm",
        "footer": { "show": false }
      }
    },

    {
      "type": "row",
      "title": "Health & Lifecycle",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 },
      "id": 102,
      "panels": []
    },

    {
      "id": 45,
      "type": "table",
      "title": "Health Check Status",
      "description": "Containers that have Docker health checks configured, with their current status. Unhealthy and starting containers sort to the top.",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "container_health_state{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "env": true,
              "node": true,
              "vm_role": true,
              "instance": true,
              "job": true,
              "compose_project": true,
              "container": true,
              "name": true
            },
            "indexByName": {
              "host": 0,
              "service": 1,
              "image": 2,
              "Value": 3
            },
            "renameByName": {
              "host": "Host",
              "service": "Service",
              "image": "Image",
              "Value": "Status"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-1": { "text": "No check", "color": "text", "index": 0 },
                      "0": { "text": "Starting", "color": "yellow", "index": 1 },
                      "1": { "text": "Healthy", "color": "green", "index": 2 },
                      "2": { "text": "Unhealthy", "color": "red", "index": 3 }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "applyToRow": true }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Image" },
            "properties": [
              { "id": "custom.width", "value": 250 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Service" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Focus on ${__data.fields.Service}",
                    "url": "/d/homelab-container-workbench?${__url_time_range}&var-service=${__data.fields.Service}&var-host=${__data.fields.Host}&${node:queryparam}&${vm_role:queryparam}",
                    "targetBlank": false
                  },
                  {
                    "title": "View Logs \u2192",
                    "url": "/d/homelab-log-workbench?${__url_time_range}&var-host=${__data.fields.Host}&var-service=${__data.fields.Service}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Status", "desc": true }],
        "cellHeight": "sm",
        "footer": { "show": false }
      }
    },

    {
      "id": 44,
      "type": "table",
      "title": "Recent Restarts",
      "description": "Containers that started within the current time range \u2014 indicates a restart or fresh deployment. Click a service name to view logs around the restart.",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "container_start_time_seconds{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"} * 1000 > (time() - $__range_s) * 1000",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "env": true,
              "node": true,
              "vm_role": true,
              "compose_project": true,
              "container": true,
              "image": true,
              "instance": true,
              "job": true,
              "name": true
            },
            "indexByName": {
              "host": 0,
              "service": 1,
              "Value #A": 2
            },
            "renameByName": {
              "host": "Host",
              "service": "Service",
              "Value #A": "Started At"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Started At" },
            "properties": [
              { "id": "unit", "value": "dateTimeFromNow" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Service" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Logs around restart \u2192",
                    "url": "/d/homelab-log-workbench?${__url_time_range}&var-host=${__data.fields.Host}&var-service=${__data.fields.Service}",
                    "targetBlank": true
                  },
                  {
                    "title": "Check host resources \u2192 (OOM? Disk? Memory?)",
                    "url": "/d/homelab-host-workbench?${__url_time_range}&var-host=${__data.fields.Host}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Started At", "desc": true }],
        "cellHeight": "sm",
        "footer": { "show": false }
      }
    },

    {
      "type": "row",
      "title": "Per-Container Detail",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
      "id": 103,
      "panels": []
    },

    {
      "id": 41,
      "type": "timeseries",
      "title": "Container CPU",
      "description": "CPU usage per container (fraction of one core). Narrow $service to focus on a single container.",
      "gridPos": { "x": 0, "y": 23, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (service) (rate(container_cpu_usage_seconds_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "none" },
            "axisSoftMin": 0
          },
          "color": { "mode": "palette-classic-by-name" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "links": [
            {
              "title": "View Logs \u2192",
              "url": "/d/homelab-log-workbench?${__url_time_range}&var-host=${__field.labels.host}&var-service=${__field.labels.service}",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        }
      }
    },

    {
      "id": 42,
      "type": "timeseries",
      "title": "Container Memory",
      "description": "Working set memory per container (what the OOM killer uses). The dashed line shows the Docker memory limit \u2014 when usage approaches it, the container is at risk of being OOM-killed.",
      "gridPos": { "x": 8, "y": 23, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (service) (container_memory_working_set_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"})",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (service) (container_spec_memory_limit_bytes{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"} > 0)",
          "legendFormat": "Limit: {{service}}",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "none" },
            "axisSoftMin": 0
          },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "links": [
            {
              "title": "View Logs \u2192",
              "url": "/d/homelab-log-workbench?${__url_time_range}&var-host=${__field.labels.host}&var-service=${__field.labels.service}",
              "targetBlank": true
            }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/^Limit:/" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        }
      }
    },

    {
      "id": 43,
      "type": "timeseries",
      "title": "Container Network",
      "description": "Network throughput per container. Receive (positive) and transmit (negative) form a bidirectional view \u2014 asymmetry is immediately visible.",
      "gridPos": { "x": 16, "y": 23, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (service) (rate(container_network_receive_bytes_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{service}} rx",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "- sum by (service) (rate(container_network_transmit_bytes_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{service}} tx",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "links": [
            {
              "title": "View Logs \u2192",
              "url": "/d/homelab-log-workbench?${__url_time_range}&var-host=${__field.labels.host}&var-service=${__field.labels.service}",
              "targetBlank": true
            }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/rx$/" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 15 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/tx$/" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        }
      }
    },

    {
      "type": "row",
      "title": "Saturation & I/O",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
      "id": 104,
      "panels": []
    },

    {
      "id": 46,
      "type": "timeseries",
      "title": "CPU Throttling",
      "description": "CFS throttle time per container. Non-zero means the container is hitting its CPU limit and being forced to wait. Common in Authentik, Loki, and database containers under load.",
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (service)(rate(container_cpu_cfs_throttled_seconds_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          },
          "color": { "mode": "palette-classic-by-name" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        }
      }
    },

    {
      "id": 47,
      "type": "timeseries",
      "title": "Memory: RSS vs Cache",
      "description": "RSS = actual memory the container needs (what OOM killer considers). Cache = kernel page cache (reclaimable). High cache is normal for database and log-heavy containers; high RSS with upward trend indicates a memory leak.",
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (service)(container_memory_rss{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"})",
          "legendFormat": "{{service}} RSS",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource_prometheus}" },
          "editorMode": "code",
          "expr": "sum by (service)(container_memory_cache{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", service=~\"$service\", name!=\"\", image!=\"\"})",
          "legendFormat": "{{service}} cache",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/cache$/" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 6] } },
              { "id": "custom.fillOpacity", "value": 5 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "semi-dark-blue" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        }
      }
    },

    {
      "id": 48,
      "type": "timeseries",
      "title": "Disk I/O",
      "description": "Container filesystem write and read rates. High write rates from Prometheus, Loki, or databases are normal; unexpected spikes from app containers may indicate issues.",
