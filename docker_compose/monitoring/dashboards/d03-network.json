    {
      "id": 14,
      "type": "timeseries",
      "title": "Container Traffic",
      "description": "Total network traffic (rx+tx) per container, stacked. This includes both internal (container-to-container) and external (internet) traffic — cAdvisor cannot distinguish them. For media/VPN stacks, the VPN container (ExpressVPN) traffic is a good proxy for actual internet egress. To measure true internet-only bandwidth, add node_exporter to the host and monitor the physical NIC.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "sum by (service) (rate(container_network_receive_bytes_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", name!=\"\", image!=\"\"}[$__rate_interval]) + rate(container_network_transmit_bytes_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", name!=\"\", image!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "gradientMode": "scheme",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "links": [
            {
              "title": "Container detail →",
              "url": "/d/homelab-container-workbench?${__url_time_range}&var-service=${__field.labels.service}&${host:queryparam}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "Top Traffic",
      "description": "Containers ranked by current combined network traffic. Includes internal + external. In a VPN media stack, the vpn container’s traffic represents actual internet usage. Click to investigate.",
      "gridPos": {
        "x": 14,
        "y": 26,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (host, service) (rate(container_network_receive_bytes_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", name!=\"\", image!=\"\"}[$__rate_interval]) + rate(container_network_transmit_bytes_total{node=~\"$node\", vm_role=~\"$vm_role\", host=~\"$host\", name!=\"\", image!=\"\"}[$__rate_interval])))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "host": 0,
              "service": 1,
              "Value": 2
            },
            "renameByName": {
              "host": "Host",
              "service": "Service",
              "Value": "Bandwidth"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Bandwidth"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1048576
                    },
                    {
                      "color": "red",
                      "value": 10485760
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Container detail →",
                    "url": "/d/homelab-container-workbench?${__url_time_range}&var-service=${__data.fields.Service}&var-host=${__data.fields.Host}",
                    "targetBlank": false
                  },
                  {
                    "title": "View Logs →",
                    "url": "/d/homelab-log-workbench?${__url_time_range}&var-service=${__data.fields.Service}&var-host=${__data.fields.Host}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Bandwidth",
            "desc": true
          }
        ],
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
