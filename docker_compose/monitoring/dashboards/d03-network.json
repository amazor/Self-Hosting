    {
      "id": 20,
      "type": "stat",
      "title": "VPN Status",
      "description": "Whether the ExpressVPN tunnel is connected. Green = tunnel up, Red = disconnected. If disconnected, qBittorrent traffic is blocked by Network Lock.",
