# Monitoring VM — env template (copy to .env and fill)
#   cp .env.example .env
# Stack reference: docker_compose/monitoring/compose.yml
# Docs: docs/Chapter2b-monitoring.md

# --- Base paths / locale ---
# Root for all state/config used by this monitoring stack. Relative paths are
# resolved from the directory where you run docker compose (e.g. docker_compose/monitoring).
# All data lives on LOCAL disk — NFS is NOT supported for Prometheus TSDB,
# Loki TSDB, or Uptime Kuma SQLite (data corruption risk).
CONFIG_ROOT=./config
TZ=Etc/UTC

# --- VM identity (used by observability labels) ---
# Hostname label applied to metrics and logs from this VM.
# Default: auto-detected from system hostname.
# VM_HOSTNAME=monitoring
# VM role (e.g. core, media, monitoring). Default: derived from stack directory name.
# VM_ROLE=monitoring
# Proxmox node name. Default: read from /etc/homelab/proxmox-node, else pve1.
# PROXMOX_NODE=pve1

# --- VM user (Uptime Kuma + Alloy) ---
# Run: python3 scripts/setup_env.py  to pre-fill PUID, PGID, DOCKER_GID from this host.
# Uptime Kuma and Alloy run as this user; bootstrap chowns their data dirs to it.
# Optional: set manually if different from the user running bootstrap/compose.
PUID=1000
PGID=1000
# Docker group GID so Alloy can read the Docker socket (group_add in compose).
# Pre-filled by setup_env.py when the docker group exists on the host.
DOCKER_GID=989

# --- Grafana ---
# Admin password for initial login. Default below is for convenience; bootstrap
# requires a strong password unless you run with --force (e.g. local testing only).
GRAFANA_ADMIN_PASSWORD=admin
# Optional: override admin username (compose default: admin).
# GRAFANA_ADMIN_USER=admin
# Set when behind reverse proxy (OAuth redirects, login links). Unset = http://localhost:3000.
# GF_SERVER_ROOT_URL=https://grafana.example.com

# --- Retention ---
# How long to keep metrics and logs. Tune to balance history vs disk usage.
# At 30d with ~5 VMs: expect ~3-5 GB Prometheus + ~5-15 GB Loki.
# Resize VM disk to 40-50 GB if keeping 30d; reduce if disk is tight.
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=30d

# --- Observability sidecars (cAdvisor + node_exporter + Alloy) ---
# Set to 0 to disable. Default: enabled.
# Sidecars live in compose.observability.yml (shared overlay).
ENABLE_OBSERVABILITY=1
# Alloy pushes logs here (Loki endpoint). On monitoring VM, use host.docker.internal.
LOKI_URL=http://host.docker.internal:3100
# Alloy pushes self-metrics here (Prometheus remote_write endpoint).
PROMETHEUS_URL=http://host.docker.internal:9090

# --- Prometheus remote scrape targets ---
# VMs running observability sidecars. Bootstrap generates Prometheus file_sd
# targets from this list. Format: hostname:ip (comma-separated).
# vm_role defaults to hostname; node defaults to PROXMOX_NODE.
# Re-run bootstrap to regenerate targets after editing.
# Prometheus picks up changes automatically (file_sd polls every 5m).
# Leave empty for single-VM setups (only local targets will be scraped).
# SCRAPE_TARGETS=core:192.168.1.110,media:192.168.1.111
SCRAPE_TARGETS=

# Plex exporter (prometheus-plex-exporter on accelerated VM, port 9000).
# Same format as SCRAPE_TARGETS: hostname:ip. Set to the accelerated VM hostname and IP.
# Only needed if the accelerated stack has ENABLE_OBSERVABILITY=1 and compose.plex-exporter.yml.
# PLEX_EXPORTER_TARGETS=accelerated:192.168.1.112
PLEX_EXPORTER_TARGETS=

# --- Image tags (pin after validation for reproducibility) ---
# Leave unset to use compose defaults (e.g. latest).
# GRAFANA_TAG=latest
# PROMETHEUS_TAG=latest
# LOKI_TAG=3
# BLACKBOX_TAG=latest
# UPTIME_KUMA_TAG=2
# NODE_EXPORTER_TAG=latest
# CADVISOR_TAG=latest
# ALLOY_TAG=latest
