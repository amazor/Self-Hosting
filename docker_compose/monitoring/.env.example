# Monitoring VM — env template (copy to .env and fill)
#   cp .env.example .env
# Stack reference: docker_compose/monitoring/compose.yml
# Docs: docs/Chapter2b-monitoring.md

# --- Base paths / locale ---
# Root for all state/config used by this monitoring stack.
# All data lives on LOCAL disk — NFS is NOT supported for Prometheus TSDB,
# Loki TSDB, or Uptime Kuma SQLite (data corruption risk).
CONFIG_ROOT=./config
TZ=Etc/UTC

# --- Grafana ---
# Admin password for initial login. Change from placeholder before deploying.
# Generate a strong password or use: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Optional: override admin username (default: admin).
# GRAFANA_ADMIN_USER=admin
# Set to your public URL when behind a reverse proxy (used for OAuth redirects, links, etc.).
# GF_SERVER_ROOT_URL=https://grafana.example.com

# --- Retention ---
# How long to keep metrics and logs. Tune to balance history vs disk usage.
# At 30d with ~5 VMs: expect ~3-5 GB Prometheus + ~5-15 GB Loki.
# Resize VM disk to 40-50 GB if keeping 30d; reduce if disk is tight.
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=30d

# --- Labels ---
# Hostname label applied to metrics and logs from this VM.
# Used in Prometheus scrape labels and Alloy log labels.
MONITORING_HOSTNAME=monitoring

# --- Image tags (pin after validation for reproducibility) ---
# Leave unset to use compose defaults.
# GRAFANA_TAG=latest
# PROMETHEUS_TAG=latest
# LOKI_TAG=3
# UPTIME_KUMA_TAG=2
# NODE_EXPORTER_TAG=latest
# CADVISOR_TAG=latest
# ALLOY_TAG=latest
