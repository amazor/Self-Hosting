# Monitoring VM — env template (copy to .env and fill)
#   cp .env.example .env
# Stack reference: docker_compose/monitoring/compose.yml
# Docs: docs/Chapter2b-monitoring.md

# --- Base paths / locale ---
# Root for all state/config used by this monitoring stack. Relative paths are
# resolved from the directory where you run docker compose (e.g. docker_compose/monitoring).
# All data lives on LOCAL disk — NFS is NOT supported for Prometheus TSDB,
# Loki TSDB, or Uptime Kuma SQLite (data corruption risk).
CONFIG_ROOT=./config
TZ=Etc/UTC

# --- VM identity (used by observability labels) ---
# Auto-filled by setup_env.py from system hostname.
VM_HOSTNAME=
# Auto-filled by setup_env.py (stack directory name).
VM_ROLE=monitoring
# Auto-filled by setup_env.py from /etc/homelab/proxmox-node; default: pve1.
PROXMOX_NODE=pve1

# --- VM user (Uptime Kuma + Alloy) ---
# Auto-filled by setup_env.py from current user (id -u / id -g).
# Uptime Kuma and Alloy run as this user; bootstrap chowns their data dirs to it.
PUID=1000
PGID=1000
# Auto-filled by setup_env.py. Verify: getent group docker | cut -d: -f3
DOCKER_GID=989

# --- Grafana ---
# Admin password for initial login. Default below is for convenience; bootstrap
# requires a strong password unless you run with --force (e.g. local testing only).
GRAFANA_ADMIN_PASSWORD=admin
# Optional: override admin username (compose default: admin).
# GRAFANA_ADMIN_USER=admin
# Set when behind reverse proxy (OAuth redirects, login links). Unset = http://localhost:3000.
# GF_SERVER_ROOT_URL=https://grafana.example.com

# --- Retention ---
# How long to keep metrics and logs. Tune to balance history vs disk usage.
# At 30d with ~5 VMs: expect ~3-5 GB Prometheus + ~5-15 GB Loki.
# Resize VM disk to 40-50 GB if keeping 30d; reduce if disk is tight.
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=30d

# --- Observability sidecars (cAdvisor + node_exporter + Alloy) ---
# Set to 0 to disable. Default: enabled.
# Sidecars live in compose.observability.yml (shared overlay).
ENABLE_OBSERVABILITY=1
# Alloy pushes logs here (Loki endpoint). On monitoring VM, use host.docker.internal.
LOKI_URL=http://host.docker.internal:3100
# Alloy pushes self-metrics here (Prometheus remote_write endpoint).
PROMETHEUS_URL=http://host.docker.internal:9090

# --- Prometheus remote scrape targets ---
# VMs running observability sidecars. Bootstrap generates Prometheus file_sd
# targets from this list. Format: hostname:ip (comma-separated).
# vm_role defaults to hostname; node defaults to PROXMOX_NODE.
# Re-run bootstrap to regenerate targets after editing.
# Prometheus picks up changes automatically (file_sd polls every 5m).
# Leave empty for single-VM setups (only local targets will be scraped).
# SCRAPE_TARGETS=core:192.168.1.110,media:192.168.1.111
SCRAPE_TARGETS=

# Plex exporter (prometheus-plex-exporter on accelerated VM, port 9000).
# Same format as SCRAPE_TARGETS: hostname:ip. Set to the accelerated VM hostname and IP.
# Only needed if the accelerated stack has ENABLE_OBSERVABILITY=1 and compose.plex-exporter.yml.
# PLEX_EXPORTER_TARGETS=accelerated:192.168.1.112
PLEX_EXPORTER_TARGETS=

# ExpressVPN exporter (misioslav/expressvpn built-in metrics on media VM, port 9797).
# Same format as SCRAPE_TARGETS: hostname:ip. Set to the media VM hostname and IP.
# Only needed if the media stack uses the misioslav/expressvpn container with METRICS_PROMETHEUS=on.
# EXPRESSVPN_EXPORTER_TARGETS=media:192.168.1.130
EXPRESSVPN_EXPORTER_TARGETS=

# scraparr (*arr suite metrics exporter on media VM, port 7100).
# Exports queue depth, library size, missing content, indexer health for Sonarr/Radarr/Prowlarr.
# Same format as SCRAPE_TARGETS: hostname:ip. Set to the media VM hostname and IP.
# Only needed if the media stack has ENABLE_EXPORTERS=1 (compose.exporters.yml).
# SCRAPARR_EXPORTER_TARGETS=media:192.168.1.130
SCRAPARR_EXPORTER_TARGETS=

# qBittorrent exporter (martabal/qbittorrent-exporter on media VM, port 17871).
# Exports download/upload speed, torrent states, ratios, stalled detection.
# Same format as SCRAPE_TARGETS: hostname:ip. Set to the media VM hostname and IP.
# Only needed if the media stack has ENABLE_EXPORTERS=1 (compose.exporters.yml).
# QBITTORRENT_EXPORTER_TARGETS=media:192.168.1.130
QBITTORRENT_EXPORTER_TARGETS=

# --- Blackbox Exporter probe targets (optional) ---
# Populates config/prometheus/targets/blackbox-targets.json via bootstrap.
# Feeds the D03 Network/Connectivity dashboard and D00's connectivity panel.
# Bootstrap regenerates this file every run from the vars below; leave any of
# them empty to skip that probe category. See docs/Chapter3b-monitoring-stack.md.

# HTTP(S) probes (module: http_2xx). Format: name:url (comma-separated).
# Validates DNS + TLS + HTTP in one probe; blackbox's http prober also exposes
# probe_ssl_earliest_cert_expiry for https:// targets (feeds the TLS expiry panel).
# Example: BLACKBOX_HTTP_TARGETS=public:https://example.com,grafana:https://grafana.example.com
BLACKBOX_HTTP_TARGETS=

# TCP reachability probes (module: tcp_connect). Format: name:host:port (comma-separated).
# Example: BLACKBOX_TCP_TARGETS=core-proxy:192.168.1.110:443,nas-nfs:192.168.1.100:2049
BLACKBOX_TCP_TARGETS=

# ICMP (ping) probes (module: icmp). Format: name:host (comma-separated).
# Example: BLACKBOX_ICMP_TARGETS=nas:192.168.1.100
BLACKBOX_ICMP_TARGETS=

# DNS resolver probes (module: dns_udp; queries the "google.com" A record — see
# config/blackbox-exporter/blackbox.yml). Format: name:host:port (comma-separated).
# Example: BLACKBOX_DNS_TARGETS=core-dnsmasq:192.168.1.110:53
BLACKBOX_DNS_TARGETS=

# --- Image tags (pin after validation for reproducibility) ---
# Leave unset to use compose defaults (e.g. latest).
# GRAFANA_TAG=latest
# PROMETHEUS_TAG=latest
# LOKI_TAG=3
# BLACKBOX_TAG=latest
# UPTIME_KUMA_TAG=2
# NODE_EXPORTER_TAG=latest
# CADVISOR_TAG=latest
# ALLOY_TAG=latest
# GRAFANA_RENDERER_TAG=latest
# GRAFANA_MCP_TAG=latest

# --- DEV ONLY: Grafana MCP tooling (dev/grafana-mcp-tooling branch) ---
# Dashboard-design tooling only — grafana-mcp + grafana-image-renderer sidecars
# in compose.yml. Not meant to reach main. Grafana service-account token
# (Admin role) for the grafana-mcp container. See
# docs/Chapter3b-monitoring-stack.md for how to generate one.
# GRAFANA_MCP_API_KEY=
# Shared secret between the grafana service and grafana-image-renderer —
# Grafana refuses to start rendering in production mode with the renderer's
# default (disabled) token. Generate with: openssl rand -hex 24
# GRAFANA_RENDERER_TOKEN=
