# Media VM — env template (copy to .env and fill)
#   cp .env.example .env
# See docs/Chapter2c-media.md and docs/Chapter3c-media-stack.md for context.

# --- Paths ---
# Root for media storage: downloads + library (must be one filesystem for hardlinks).
# Host layout follows Chapter 2c:
#   /mnt/media/downloads/{qbittorrent,sabnzbd}/...
#   /mnt/media/library/{tv,anime,movies}
# In containers this host root is mounted to /data (no remote path mapping).
# Local testing: leave as /mnt/media; bootstrap creates it and downloads/library if missing.
# Prod with NFS: mount your NFS export at this path (e.g. /mnt/media) before starting.
MEDIA_ROOT=/mnt/media
# Root for app config/data (can be next to compose or e.g. /opt/media/config).
CONFIG_ROOT=./config

# --- Identity (LinuxServer images: match host user for volume permissions) ---
# Auto-filled by setup_env.py from current user (id -u / id -g).
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- VPN (ExpressVPN) — required for torrent routing ---
# Uses misioslav/expressvpn container with native ExpressVPN CLI activation.
# Ref: https://github.com/Misioslav/expressvpn
# Docker Hub: https://hub.docker.com/r/misioslav/expressvpn
#
# Activation code: get from https://www.expressvpn.com/setup (required).
EXPRESSVPN_CODE=
# Server: region name, alias, or "smart" (auto-select nearest). Default: smart.
# List available servers: docker exec vpn expressvpnctl get regions
EXPRESSVPN_SERVER=smart
# Protocol: lightwayudp (default, fastest), lightwaytcp, wireguard, openvpntcp, openvpnudp, auto.
EXPRESSVPN_PROTOCOL=lightwayudp
# LAN access: allow containers and host to reach each other while Network Lock is on.
EXPRESSVPN_ALLOW_LAN=true
# LAN CIDR: comma-separated subnets exempted from the VPN kill switch.
# Must include BOTH your LAN subnet AND the Docker bridge subnets — without the
# Docker subnets (*arr apps reach qBittorrent via vpn:8080 over the bridge),
# Sonarr/Radarr will lose connectivity to qBittorrent after a VPN restart.
# Auto-filled by setup_env.py (detects LAN /24 + adds Docker defaults).
# Example: EXPRESSVPN_LAN_CIDR=192.168.1.0/24,172.18.0.0/16
# EXPRESSVPN_LAN_CIDR=

# --- *arr app authentication ---
# Bootstrap pre-seeds config.xml for Sonarr, Radarr, and Prowlarr on first run.
# Default: External (delegates auth to Authentik/Caddy forward auth; no app login page).
# Set to Forms if you want the apps' own username/password login page instead.
# Ref: https://integrations.goauthentik.io/media/sonarr/
# ARR_AUTH_METHOD=External

# --- Torrent indexer health (Sonarr/Radarr per-indexer defaults) ---
# Applied by setup_media_apps.py to all torrent indexers after Prowlarr sync.
# Prevents stalled downloads from low-seed torrents.
# Ref: https://wiki.servarr.com/radarr/settings#torrent-tracker-configuration
#
# Minimum seeders required for Sonarr/Radarr to grab a torrent release.
# Public trackers: 5–10; private trackers: 1–3.
TORRENT_MIN_SEEDERS=5
# Minimum seed ratio before *arr tells the download client to pause/remove.
# Empty = use download client default. Common: 1.0 for private trackers.
# TORRENT_SEED_RATIO=
# Minimum seed time in minutes before *arr tells the download client to pause/remove.
# Empty = use download client default. Example: 1440 (24 hours).
# TORRENT_SEED_TIME=

# --- Optional services (overlays) ---
# Set to 1 to enable. The media shell helper auto-includes these compose overlays.
#
# --- Recyclarr (optional TRaSH quality sync daemon, enabled by default) ---
# Syncs TRaSH Guide quality profiles, custom formats, and naming to Sonarr/Radarr
# on a cron schedule. TRaSH updates these periodically (new bad-encoder patterns,
# score adjustments, format changes). Running Recyclarr keeps your *arr apps current
# without manual intervention.
# Ref: https://recyclarr.dev/  https://trash-guides.info/Guide-Sync/
# Set to 0 to disable entirely.
ENABLE_RECYCLARR=1
# Cron schedule for TRaSH syncs. Default: @weekly.
# Examples: @daily, @weekly, "0 3 * * 0" (Sundays at 3am).
RECYCLARR_CRON=@weekly
# ENABLE_CLEANUPARR=1
# ENABLE_SABNZBD=1
# ENABLE_BAZARR=1
# ENABLE_NTFY=1

# --- Prometheus exporters (compose.exporters.yml) ---
# Scraparr (*arr metrics) + qBittorrent exporter. Powers the D04 Media Pipeline dashboard.
# Set to 0 to disable. Default: enabled.
ENABLE_EXPORTERS=1
# API keys for scraparr — auto-populated into .env by bootstrap from pre-seeded config.xml.
# No manual filling needed; bootstrap reads the keys after seeding *arr configs.
# SONARR_API_KEY=
# RADARR_API_KEY=
# PROWLARR_API_KEY=
# qBittorrent Web UI credentials. Bootstrap pre-seeds qBittorrent.conf with a PBKDF2 hash
# of this password so qBittorrent starts with a known password (4.6.1+ generates a random
# temp password otherwise). setup_media_apps.py and the exporter both read these values.
# QBITTORRENT_USERNAME=admin
# QBITTORRENT_PASSWORD=adminadmin
# Exporter image tags
# SCRAPARR_TAG=latest
# QBITTORRENT_EXPORTER_TAG=latest

# --- VM identity (used by observability labels) ---
# Auto-filled by setup_env.py from system hostname.
VM_HOSTNAME=
# Auto-filled by setup_env.py (stack directory name).
VM_ROLE=media
# Auto-filled by setup_env.py from /etc/homelab/proxmox-node; default: pve1.
PROXMOX_NODE=pve1

# --- Observability sidecars (cAdvisor + node_exporter + Alloy) ---
# Set to 0 to disable. Default: enabled. Requires a running monitoring VM.
# Sidecars live in compose.observability.yml (shared overlay).
ENABLE_OBSERVABILITY=1
# Alloy pushes logs here (Loki endpoint on monitoring VM).
LOKI_URL=http://MONITORING_VM_IP:3100
# Alloy pushes self-metrics here (Prometheus remote_write on monitoring VM).
PROMETHEUS_URL=http://MONITORING_VM_IP:9090
# Auto-filled by setup_env.py. Verify: getent group docker | cut -d: -f3
DOCKER_GID=989

# --- Optional runtime tuning ---
# FLARESOLVERR_LOG_LEVEL=info

# --- Optional image tags (pin for reproducible redeploys) ---
# Leave unset to use compose defaults.
# EXPRESSVPN_TAG=latest
# QBITTORRENT_TAG=latest
# SONARR_TAG=latest
# RADARR_TAG=latest
# PROWLARR_TAG=latest
# FLARESOLVERR_TAG=latest
# SABNZBD_TAG=latest
# BAZARR_TAG=latest
# RECYCLARR_TAG=latest
# CLEANUPARR_TAG=latest
# NTFY_TAG=latest
