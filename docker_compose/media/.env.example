# Media VM — env template (copy to .env and fill)
#   cp .env.example .env
# See docs/Chapter2c-media.md and docs/Chapter3c-media-stack.md for context.

# --- Paths ---
# Root for media storage: downloads + library (must be one filesystem for hardlinks).
# Host layout follows Chapter 2c:
#   /mnt/media/downloads/{qbittorrent,sabnzbd}/...
#   /mnt/media/library/{tv,anime,movies}
# In containers this host root is mounted to /data (no remote path mapping).
# Local testing: leave as /mnt/media; bootstrap creates it and downloads/library if missing.
# Prod with NFS: mount your NFS export at this path (e.g. /mnt/media) before starting.
MEDIA_ROOT=/mnt/media
# Root for app config/data (can be next to compose or e.g. /opt/media/config).
CONFIG_ROOT=./config

# --- Identity (LinuxServer images: match host user for volume permissions) ---
# Run: id your_user  → use uid as PUID, gid as PGID.
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- VPN (Gluetun / ExpressVPN) — required for torrent routing ---
OPENVPN_USER=
OPENVPN_PASSWORD=
# Optional: restrict to country/city (comma-separated)
# SERVER_COUNTRIES=Netherlands
# SERVER_CITIES=Amsterdam

# --- Optional services (overlays) ---
# Set to 1 to enable. deploy.sh and the media shell helper auto-include these compose overlays.
# ENABLE_BUILDARR_RECYCLARR=1
# ENABLE_CLEANUPARR=1
# ENABLE_SABNZBD=1
# ENABLE_BAZARR=1
# ENABLE_NTFY=1

# --- VM identity (used by observability labels) ---
# Hostname label applied to metrics and logs from this VM.
# Default: auto-detected from system hostname.
# VM_HOSTNAME=media
# VM role (e.g. core, media, monitoring). Default: derived from stack directory name.
# VM_ROLE=media
# Proxmox node name. Default: read from /etc/homelab/proxmox-node, else pve1.
# PROXMOX_NODE=pve1

# --- Observability sidecars (cAdvisor + node_exporter + Alloy) ---
# Set to 0 to disable. Default: enabled. Requires a running monitoring VM.
# Sidecars live in compose.observability.yml (shared overlay).
ENABLE_OBSERVABILITY=1
# Alloy pushes logs here (Loki endpoint on monitoring VM).
LOKI_URL=http://MONITORING_VM_IP:3100
# Alloy pushes self-metrics here (Prometheus remote_write on monitoring VM).
PROMETHEUS_URL=http://MONITORING_VM_IP:9090
# Docker group GID so Alloy can read the Docker socket (group_add in compose).
# Find with: getent group docker | cut -d: -f3
DOCKER_GID=989

# --- Optional runtime tuning ---
# FLARESOLVERR_LOG_LEVEL=info

# --- Optional image tags (pin for reproducible redeploys) ---
# Leave unset to use compose defaults.
# GLUETUN_TAG=latest
# QBITTORRENT_TAG=latest
# SONARR_TAG=latest
# RADARR_TAG=latest
# PROWLARR_TAG=latest
# FLARESOLVERR_TAG=latest
# SABNZBD_TAG=latest
# BAZARR_TAG=latest
# BUILDARR_TAG=latest
# RECYCLARR_TAG=latest
# CLEANUPARR_TAG=latest
# NTFY_TAG=latest
