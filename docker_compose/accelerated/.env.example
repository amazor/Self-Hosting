# Accelerated VM — env template (copy to .env and fill)
#   cp .env.example .env
#
# Stack reference: docker_compose/accelerated/compose.yml
# Docs: docs/Chapter2d-accelerated.md and docs/Chapter3d-accelerated-stack.md

# --- Paths ---
# Media library export from the Media VM (final organized library only).
# Default assumes /mnt/media is an NFS mount or local disk with:
#   /mnt/media/library/{movies,tv,anime}
MEDIA_LIBRARY_ROOT=/mnt/media/library

# Immich photo library. Kept separate from /mnt/media to avoid coupling
# video automation and personal photo storage. Mounted to /data inside the
# container, matching Immich's default IMMICH_MEDIA_LOCATION.
IMMICH_UPLOAD_ROOT=/mnt/photos/library

# Immich Postgres data directory. MUST be on local disk, not a network share,
# per Immich docs (network shares are not supported for the database).
IMMICH_DB_ROOT=./config/immich-postgres

# Root for app config/state (Plex config, Immich config, Redis state, etc.).
CONFIG_ROOT=./config

# --- NFS Mounts (optional) ---
# If set, bootstrap configures fstab entries and mounts automatically.
# If not set, ensure MEDIA_LIBRARY_ROOT and IMMICH_UPLOAD_ROOT are mounted.
# NFS_HOST=nas.local
# NFS_MEDIA_EXPORT=/volume1/media/library
# NFS_PHOTOS_EXPORT=/volume1/photos/library

# --- Identity (container run-as user) ---
# Auto-filled by setup_env.py from current user (id -u / id -g).
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Plex ---
# First-run claim token (one-time only).
#   1. Go to https://www.plex.tv/claim and copy the claim-xxxx token
#   2. Paste it here and deploy within 4 minutes (token expires quickly)
#   3. After Plex starts, bootstrap auto-clears this value
# Only needed on first deploy when Plex has never been claimed on this host.
# Leave empty on subsequent deploys — bootstrap skips it if already claimed.
PLEX_CLAIM=

# Permanent Plex API token (X-Plex-Token). Used for:
#   - setup_accelerated_apps.py (TRaSH server settings, library creation)
#   - Prometheus Plex exporter (metrics)
#   - Sonarr/Radarr → Plex refresh notifications (via media VM's .env)
# Auto-extracted: on first deploy with PLEX_CLAIM, post_deploy reads
# PlexOnlineToken from Preferences.xml and writes it here automatically.
# Manual fallback: https://support.plex.tv/articles/204059436
PLEX_TOKEN=

# LAN IP (or hostname) of this VM, used by Sonarr/Radarr on the Media VM to
# reach Plex for library refresh notifications. Example: 192.168.1.140
PLEX_HOST=

# Optional: pin a known-good Plex image tag once validated.
# PLEX_TAG=latest

# Plex exporter (prometheus-plex-exporter). Used only when ENABLE_OBSERVABILITY=1.
# PLEX_SERVER: URL reachable from the exporter container on this VM.
PLEX_SERVER=http://plex:32400

# --- iperf3 network bandwidth test server ---
# Always-on server used to diagnose remote-Plex throughput. It lives on THIS VM
# (where Plex runs) so a test traverses the same router -> VM path as real Plex
# streaming. iperf3 is NOT HTTP, so it cannot go behind Caddy — it listens on
# its own raw TCP+UDP port.
#
# How to use (the test is two-sided):
#   1. Server runs here 24/7 (no action needed after deploy).
#   2. To test "through the internet", TEMPORARILY add a router port-forward of
#      TCP+UDP ${IPERF3_PORT} -> this VM's LAN IP, run the test, then REMOVE it.
#      iperf3 has NO AUTHENTICATION; an open port invites bandwidth abuse.
#   3. From the remote location, run a CLIENT (helper prints exact commands):
#        iperf3 -c <public-domain-or-ip> -p 5201 -R -t 30        # upload bandwidth (TCP, Plex-like)
#        iperf3 -c <public-domain-or-ip> -p 5201 -u -R -b 25M -t 30  # jitter/loss (UDP)
#   Generate ready-to-paste commands: python3 scripts/iperf3_test.py
#
# iperf3 server image (mm404/iperf3). Uses compose default (latest) until pinned.
# IPERF3_TAG=3.20.0-alpine3.23.4
# Port iperf3 listens on (server) and that the client connects to.
IPERF3_PORT=5201
# Host interface to bind. Default 0.0.0.0 so the router forward works out of the
# box. Set to the VM LAN IP (e.g. 192.168.1.140) to restrict which NIC listens.
IPERF3_BIND_IP=0.0.0.0

# --- Immich ---
# Version tag used for the Immich images. Pin once you find a stable version.
IMMICH_VERSION=v2

# Postgres password for Immich. Use only A–Z, a–z, 0–9 (no special chars) to
# avoid Docker parsing issues, per Immich docs.
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- VM identity (used by observability labels) ---
# Auto-filled by setup_env.py from system hostname.
VM_HOSTNAME=
# Auto-filled by setup_env.py (stack directory name).
VM_ROLE=accelerated
# Auto-filled by setup_env.py from /etc/homelab/proxmox-node; default: pve1.
PROXMOX_NODE=pve1

# --- Observability sidecars (cAdvisor + node_exporter + Alloy) + Plex exporter ---
# Set to 0 to disable. Default: enabled. Requires a running monitoring VM.
# Sidecars live in compose.observability.yml (shared overlay).
# When enabled, compose.plex-exporter.yml is also included (Plex metrics on port 9000).
ENABLE_OBSERVABILITY=1

# Alloy pushes logs here (Loki endpoint on monitoring VM).
LOKI_URL=http://MONITORING_VM_IP:3100

# Alloy pushes self-metrics here (Prometheus remote_write on monitoring VM).
PROMETHEUS_URL=http://MONITORING_VM_IP:9090

# Auto-filled by setup_env.py. Verify: getent group docker | cut -d: -f3
DOCKER_GID=989

# --- Optional image tags (pin for reproducible redeploys) ---
# Leave unset to use compose defaults; pin after validating a known-good version.
# PLEX_TAG=latest
# PLEX_EXPORTER_TAG=latest
# IMMICH_VERSION=v2
# IMMICH_POSTGRES_TAG=16-vectorchord0.5.3-pgvector0.8.1
# IMMICH_REDIS_TAG=7-alpine
# AUTOHEAL_TAG=latest

