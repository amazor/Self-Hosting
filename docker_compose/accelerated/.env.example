# Accelerated VM — env template (copy to .env and fill)
#   cp .env.example .env
#
# Stack reference: docker_compose/accelerated/compose.yml
# Docs: docs/Chapter2d-accelerated.md and docs/Chapter3d-accelerated-stack.md

# --- Paths ---
# Media library export from the Media VM (final organized library only).
# Default assumes /mnt/media is an NFS mount or local disk with:
#   /mnt/media/library/{movies,tv,anime}
MEDIA_LIBRARY_ROOT=/mnt/media/library

# Immich photo library. Kept separate from /mnt/media to avoid coupling
# video automation and personal photo storage.
IMMICH_UPLOAD_ROOT=/mnt/photos/library

# Immich Postgres data directory. MUST be on local disk, not a network share,
# per Immich docs (network shares are not supported for the database).
IMMICH_DB_ROOT=./config/immich-postgres

# Root for app config/state (Plex config, Immich config, Redis state, etc.).
CONFIG_ROOT=./config

# --- Identity (container run-as user) ---
# Auto-filled by setup_env.py from current user (id -u / id -g).
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Plex ---
# Optional claim token for first registration; get from plex.tv and
# set once before first start. Leave empty after registration.
PLEX_CLAIM=

# Optional: pin a known-good Plex image tag once validated.
# PLEX_TAG=latest

# Plex exporter (prometheus-plex-exporter). Used only when ENABLE_OBSERVABILITY=1.
# PLEX_SERVER: URL reachable from the exporter container. Same-host Plex = http://plex:32400.
PLEX_SERVER=http://plex:32400
# PLEX_TOKEN: Plex admin token (required for exporter). See: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=YOUR_PLEX_TOKEN_HERE

# --- Immich ---
# Version tag used for the Immich images. Pin once you find a stable version.
IMMICH_VERSION=v2

# Postgres password for Immich. Use only A–Z, a–z, 0–9 (no special chars) to
# avoid Docker parsing issues, per Immich docs.
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- VM identity (used by observability labels) ---
# Auto-filled by setup_env.py from system hostname.
VM_HOSTNAME=
# Auto-filled by setup_env.py (stack directory name).
VM_ROLE=accelerated
# Auto-filled by setup_env.py from /etc/homelab/proxmox-node; default: pve1.
PROXMOX_NODE=pve1

# --- Observability sidecars (cAdvisor + node_exporter + Alloy) + Plex exporter ---
# Set to 0 to disable. Default: enabled. Requires a running monitoring VM.
# Sidecars live in compose.observability.yml (shared overlay).
# When enabled, compose.plex-exporter.yml is also included (Plex metrics on port 9000).
ENABLE_OBSERVABILITY=1

# Alloy pushes logs here (Loki endpoint on monitoring VM).
LOKI_URL=http://MONITORING_VM_IP:3100

# Alloy pushes self-metrics here (Prometheus remote_write on monitoring VM).
PROMETHEUS_URL=http://MONITORING_VM_IP:9090

# Auto-filled by setup_env.py. Verify: getent group docker | cut -d: -f3
DOCKER_GID=989

# --- Optional image tags (pin for reproducible redeploys) ---
# Leave unset to use defaults where reasonable; pin after validating.
# IMMICH_SERVER_TAG=
# IMMICH_MICROSERVICES_TAG=
# IMMICH_MACHINE_LEARNING_TAG=
# IMMICH_POSTGRES_TAG=16-alpine
# IMMICH_REDIS_TAG=7-alpine

